# docker/.env.example
# Copie para docker/.env e preencha com senhas seguras antes de subir em produção.
# O docker-compose.yml lê estas variáveis via ${VAR:-default}.
# Este arquivo NÃO deve ser commitado com senhas reais.

# ── PostgreSQL + TimescaleDB ─────────────────────────────
POSTGRES_USER=vitalkare
POSTGRES_DB=vitalkare
POSTGRES_PASSWORD=vitalkare_pg

# ── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=vitalkare_redis

# ── MinIO (S3-compatible) ────────────────────────────────
MINIO_ROOT_USER=vitalkare
MINIO_ROOT_PASSWORD=vitalkare_minio

# ── MQTT (Mosquitto) ─────────────────────────────────────
MQTT_USER=vitalkare
MQTT_PASS=vitalkare_mqtt

# ── Backend FastAPI ──────────────────────────────────────
# Gere uma chave aleatória segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_POR_UMA_CHAVE_SEGURA_COM_32_BYTES

# IP da máquina host na LAN (usado pelo ESP32 para alcançar o broker)
HOST_LAN_IP=192.168.1.100
