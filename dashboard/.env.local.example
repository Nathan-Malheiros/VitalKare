# dashboard/.env.local.example
# Copie para .env.local e preencha com os valores reais da sua LAN.
# Este arquivo NÃO deve ser commitado com senhas reais.

# IP do notebook/servidor na rede local onde o backend FastAPI está rodando
VITE_BACKEND_HOST=192.168.1.100

# URL base para WebSocket (deve apontar para o mesmo host do backend)
VITE_WS_URL=ws://192.168.1.100:8000
