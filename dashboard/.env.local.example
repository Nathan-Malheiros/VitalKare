# dashboard/.env.local.example
# Copie para .env.local apenas se o backend FastAPI nao rodar nesta mesma maquina.
# Este arquivo NAO deve ser commitado com senhas reais.

# Host usado pelo proxy local do Vite para encaminhar /api e /ws para o backend.
# Em desenvolvimento local, deixe em localhost ou 127.0.0.1.
VITE_PROXY_TARGET_HOST=127.0.0.1
