# =========================================================
# VitalKare — Variáveis de ambiente do backend
# NUNCA versionar este arquivo com valores reais.
# Copie para .env e preencha antes de rodar.
# =========================================================

# Aplicação
APP_NAME="VitalKare Backend"
DEBUG=false
ENVIRONMENT=development

# Banco de Dados (PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql+asyncpg://vitalkare:CHANGE_ME@postgres:5432/vitalkare
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO_SQL=false

# Redis
REDIS_URL=redis://redis:6379/0

# MQTT Broker
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USE_TLS=false
MQTT_USERNAME=vitalkare_backend
MQTT_PASSWORD=CHANGE_ME
MQTT_CLIENT_ID=vitalkare-backend

# Segurança JWT — gere com: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_HOURS=24

# MinIO / S3
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET_AUDIO=vitalkare-audio
STORAGE_BUCKET_IMAGES=vitalkare-images
STORAGE_USE_SSL=false

# Faster-Whisper
WHISPER_MODEL=small
WHISPER_LANGUAGE=pt
WHISPER_DEVICE=cpu

# Heartbeat Monitor
HEARTBEAT_OFFLINE_THRESHOLD_S=90
HEARTBEAT_CRITICAL_THRESHOLD_S=300
HEARTBEAT_CHECK_INTERVAL_S=15

# CORS (separado por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
